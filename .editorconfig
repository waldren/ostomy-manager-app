# EditorConfig — https://editorconfig.org
# Formatting for TS/JS/JSON/MD is owned by Prettier (packages/config/prettier).
# This file covers editors and file types Prettier does not touch.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
