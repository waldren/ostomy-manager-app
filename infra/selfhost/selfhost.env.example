# The self-hosted host's own settings (infra/selfhost/README.md). Copied to
# /etc/ostomy/selfhost.env on the host and passed with --env-file.
#
# Nothing here is a secret. Secrets are files in OSTOMY_SECRETS_DIR, generated
# on the host by bin/generate-secrets.sh, and never belong in this file.

# Where bin/generate-secrets.sh wrote the secrets.
OSTOMY_SECRETS_DIR=/etc/ostomy/secrets

# The app (API and web SPA) and Keycloak. Both must resolve to this host
# before the first `up`, so Let's Encrypt can issue.
OSTOMY_DOMAIN=diary.example.org
OSTOMY_AUTH_DOMAIN=auth.diary.example.org

# Let's Encrypt's contact for expiry and revocation notices.
OSTOMY_ACME_EMAIL=operator@example.org

# Addresses allowed to reach /api/v1/admin/* and the admin realm, space
# separated, as addresses or CIDR ranges. The operator's own, and nothing
# broader. 203.0.113.0/24 is a documentation range that matches no one.
OSTOMY_ADMIN_ALLOWED_IPS=203.0.113.10/32
