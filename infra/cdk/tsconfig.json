{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ostomy/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    // aws-cdk-lib's declarations are generated by jsii, which does not model
    // `exactOptionalPropertyTypes`: an optional property is `T | undefined`
    // on the class and `T` on its own interface, so `Vpc` is not an `IVpc`.
    // Off for this workspace only, where it is the library's typing and not
    // ours that it would check.
    "exactOptionalPropertyTypes": false
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts"]
}
