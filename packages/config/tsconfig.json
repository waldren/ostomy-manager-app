{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    // This package ships JS config objects, not a typed API. Declaration emit
    // would force type annotations on re-exported third-party config shapes
    // (TS2742) for no benefit — nothing imports these for their types.
    "declaration": false,
    "declarationMap": false
  },
  "include": ["eslint/**/*.js", "prettier/**/*.js"]
}
