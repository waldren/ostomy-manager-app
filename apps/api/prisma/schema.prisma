// P1.S3 schema core. Deliberately partial — see design-specs/planning/
// v1-implementation-plan.md P1.S3 and CLAUDE.md "Data model rules that are
// easy to get wrong". Appliance, leak, skin, medication, reminder and
// Quick-Add tables are NOT here; they arrive with their own features as
// additive migrations. Do not add them speculatively.
//
// The single migration this schema corresponds to
// (prisma/migrations/20260905000000_init_schema_core/migration.sql) is
// hand-authored, not generated by `prisma migrate dev`, because it also has
// to create the runtime database role and its grants (ADR-0011) — see that
// file's header comment before changing either one without the other.
//
// Full FHIR-field-coverage / verified-vs-TODO code inventory:
// design-specs/data-model/fhir-rxnorm-integration.md and
// design-specs/data-model/p1-s3-schema-coverage.md.

generator client {
  provider               = "prisma-client"
  // Relative to this file. Lands under apps/api/src/generated/prisma, so
  // it compiles via the ordinary `tsc -p tsconfig.build.json` pass into
  // dist/ like any other source file — no separate packaging step.
  //
  // Corrected claim (P1.S3 review response — docs finding): this comment
  // previously said there is no dependency on `node_modules/@prisma/client`
  // at all. That is false and was verified false: `src/generated/prisma/
  // client.ts` imports `@prisma/client/runtime/client` directly. What
  // Prisma ORM 7's "Rust-free" client actually removes is the bundled
  // native query-engine BINARY (see the `datasource` block's own comment
  // below on `binaryTargets`/`engineType`) — not the `@prisma/client`
  // package itself, which stays a real runtime dependency
  // (`apps/api/package.json`'s own "P1.S3" note already gets this right:
  // do not prune `@prisma/client` from `dependencies` on the strength of
  // this comment; it was this comment that was wrong).
  output                 = "../src/generated/prisma"
  // apps/api is CommonJS (ADR-0010) — must match, or the generated client's
  // own module format fights the workspace's "type": "commonjs" the same
  // way a stray ESM dependency would.
  moduleFormat           = "cjs"
  runtime                = "nodejs"
  // Generated SOURCE files are .ts (compiled by this workspace's own tsc
  // pass, same as everything else in src/) but their *relative import
  // specifiers* must say .js, not .ts: tsc's CommonJS emit rewrites
  // `import`/`export` syntax to `require()`/`exports` but does NOT rewrite
  // a relative specifier's extension, so a generated file that imports
  // "./enums.ts" still requires literally "./enums.ts" after compilation —
  // a path that does not exist in dist/ (dist/generated/prisma/enums.js
  // does). This is the standard TS "nodenext" authoring convention (write
  // .ts, import .js) already implied by this workspace's
  // moduleResolution — verified empirically: importFileExtension="ts"
  // produces a dist/ build that throws MODULE_NOT_FOUND at require() time
  // with every type check green, because tsc never executes the emitted
  // require path. Do not change this without re-running `pnpm build && node
  // dist/main.js` (or equivalent) to confirm the built output actually
  // loads — a passing typecheck/test suite cannot catch this class of bug.
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// No `url` here: Prisma ORM 7 moved datasource connection strings to
// prisma.config.ts (CLI-time: migrate/introspect/studio) and to an
// explicit driver adapter at runtime (src/prisma/prisma.service.ts). This
// is also why there is no `binaryTargets`/`engineType` setting anywhere in
// this file — v7's driver-adapter architecture has no Rust query engine
// binary to target.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Numeric precision (ADR-0005)
// ---------------------------------------------------------------------------
// Every clinical decimal column in this schema uses the explicit native
// type `@db.Decimal(12, 4)`, never a bare `Decimal` (which Prisma maps to
// Postgres NUMERIC(65,30) by default — a limit nobody chose on purpose) and
// never Float/Double (binary floating point cannot represent 0.1 mL exactly,
// which is exactly the kind of silent drift ADR-0005's "stored values are
// never rounded" promise cannot tolerate in a value later summed into a
// Daily Net Fluid Balance).
//
// 12 total digits / 4 fractional digits allows up to 99,999,999.9999 in
// canonical units (mL or kg) — far beyond any plausible single entry or
// daily total — while still being a deliberate, reviewable bound rather
// than an accidental one. NUMERIC is exact (base-10) arithmetic, so no
// entered precision is lost to *binary* representation error the way
// Float/Double would lose it. That is not the same claim as "no entered
// precision is ever lost, full stop": a value with more than 4 fractional
// digits (e.g. an intermediate calculation feeding a derived observation)
// is silently rounded to scale 4 at the DECIMAL(12,4) boundary
// (1234.567891 -> 1234.5679) — exact within that scale, not unbounded.
// Every write path this migration's own codes need (patient-entered mL/kg
// values) is already at or below 4 fractional digits, so this has not
// mattered yet; it will the first time a derived-observation feature
// computes something finer-grained than that and writes it here unrounded.

// ---------------------------------------------------------------------------
// Referential actions
// ---------------------------------------------------------------------------
// Every `patientId`/`valueSetId`/self-referencing FK below is explicit
// `onDelete: Restrict`. Nothing in this schema should ever let a foreign
// key cascade delete clinical or audit-adjacent rows — the PHI retention
// and deletion policy is still pending legal counsel (ADR-0001 "Notes"),
// and a silent cascade is exactly the kind of bulk data-loss path that
// policy has not yet authorized. A deliberate deletion/erasure flow is a
// later, explicit feature, not a side effect of dropping a parent row.

// ===========================================================================
// Identity anchor
// ===========================================================================

/// The stable anchor row every clinical and configuration table hangs off.
///
/// `id` is a server-generated UUID — NOT the OIDC `sub` claim (S1 review
/// finding; reversed from this migration's original design, which used the
/// raw subject as the primary key). The subject lives in `oidcSubject`
/// below instead, as an ordinary unique, indexed lookup column.
///
/// Why the reversal, not just "a UUID looks more idiomatic": the original
/// reasoning correctly ruled out a *client-generated* UUID (the identity
/// anchor is asserted by the IdP on every request, before any sync code
/// runs, so it is not the kind of entity CLAUDE.md's "client-generated UUID
/// primary key for every synced entity" rule is about) — but that does not
/// mean the IdP's own subject belongs in the PK position either:
///
/// - The subject would otherwise propagate into every FK column that
///   references a patient (`profiles.patient_id`, `observations.patient_id`,
///   `sync_operations.patient_id`, `effective_ranges.patient_id`),
///   `audit_events.entity_id`, and every FHIR export's
///   `subject.reference: "Patient/<sub>"` — handing an IdP-internal
///   identifier to physicians on every exported Bundle.
/// - An IdP rebuild (a new user pool, a provider migration) re-mints every
///   `sub` with no indirection anywhere to absorb it, because the
///   identifier IS the row.
/// - It forecloses de-identification. With a UUID PK and a separate
///   `oidcSubject` column, severing the IdP crosswalk is
///   `UPDATE patients SET oidc_subject = NULL WHERE id = $1` — one column,
///   one table. As this migration originally shipped, the crosswalk *was*
///   the PK, so severing it meant rewriting five FK columns, and could not
///   touch `audit_events.entity_id` at all (a plain, unconstrained text
///   column with no FK to rewrite through). That distinction matters
///   concretely: the PHI retention/deletion SLA is still open with counsel
///   (ADR-0001 "Notes") — this schema must not pre-empt that decision by
///   making severance structurally harder than it needs to be.
///
/// See `oidcSubject` below for the column this displaced, and its own
/// length-bound rationale (S2).
model Patient {
  id String @id @default(uuid()) @map("id") @db.Uuid

  /// The OIDC `sub` claim `JwtAuthGuard` verifies and attaches to every
  /// authenticated request as `PatientActor.id`
  /// (apps/api/src/auth/patient-actor.ts) — an opaque, IdP-asserted
  /// identifier, never this row's own primary key (see the model doc
  /// comment above). `@unique` because every authenticated request's first
  /// database touch is "find the patient row for this subject"
  /// (`WHERE oidc_subject = $1`), and because the same human must never be
  /// representable by two `Patient` rows.
  ///
  /// Bounded at `VARCHAR(255)`, not the unbounded `TEXT` this migration
  /// originally used — the OIDC/JWT spec places no length limit on `sub`,
  /// but every real IdP this application config-adapts to (Cognito, a
  /// standard OIDC provider, the mock issuer) keeps it far under this in
  /// practice, and there is no reason for a column populated directly from
  /// an unvalidated bearer-token claim to accept an attacker-controlled
  /// unbounded string (S2).
  oidcSubject String @unique @map("oidc_subject") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         Profile?
  observations    Observation[]
  meals           Meal[]
  effectiveRanges EffectiveRange[]
  syncOperations  SyncOperation[]

  @@map("patients")
}

// ===========================================================================
// Onboarding / profile (SRS §3.0, §3.10)
// ===========================================================================

/// v1 scope only — urostomy was cut in Phase 4 (Appendix A) because a
/// urostomy's stoma output *is* urine, making it a different data model
/// rather than a third enum value here. Do not add UROSTOMY.
enum OstomyType {
  COLOSTOMY
  ILEOSTOMY

  @@map("ostomy_type")
}

/// A single preference governs both volume and weight units (SRS §3.0,
/// §3.10, ADR-0004) — one enum, not two independently-selectable fields,
/// so mL+lb or oz+kg is unrepresentable rather than merely unselectable.
enum MeasurementSystem {
  METRIC
  IMPERIAL

  @@map("measurement_system")
}

/// The settings row SRS §3.0/§3.10 describes. Unlike `Patient`, this *is* a
/// synced entity — §3.10 states explicitly that "preference changes made on
/// mobile are queued like any other write" — so `id` is client-generated
/// (ADR-0001) and it carries the same sync bookkeeping columns as
/// `Observation` and `EffectiveRange` below. See those models' comments for
/// what each sync column is for; repeated per-model rather than factored out
/// because Prisma has no mixin/trait mechanism for shared fields.
model Profile {
  id String @id @map("id") @db.Uuid

  patientId String  @unique @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  ostomyType        OstomyType        @map("ostomy_type")
  /// Lower timestamp bound for entry validation (SRS §3.0, §3.8) — a
  /// calendar date, not an instant, so `@db.Date`, not `@db.Timestamptz`.
  surgeryDate       DateTime          @map("surgery_date") @db.Date
  measurementSystem MeasurementSystem @map("measurement_system")

  /// The client-asserted wall-clock time this write was made, used for
  /// last-write-wins conflict resolution (ADR-0001) — distinct from any
  /// clinical timestamp on the row (this model has none) and from
  /// `createdAt`/`updatedAt` below, which are server bookkeeping only and
  /// must never be used for conflict resolution (a server clock adjustment
  /// must not silently change which write wins).
  clientUpdatedAt DateTime @map("client_updated_at") @db.Timestamptz(3)

  /// The server-assigned monotonic delta-sync cursor (ADR-0001) — backed by
  /// the single cross-table `sync_sequence` Postgres sequence created in
  /// this migration, so a cursor value is comparable across every synced
  /// entity type, not just within one table.
  ///
  /// The `@default(0)` below is NOT the real assignment mechanism — it
  /// exists only so Prisma's generated client treats this field as
  /// optional on `.create()` and so `prisma migrate diff`/`migrate dev`
  /// sees an ordinary, literal column default it fully understands and
  /// therefore never touches. The REAL value is assigned by a hand-authored
  /// `BEFORE INSERT OR UPDATE` trigger in the migration
  /// (`assign_sync_sequence()`), which unconditionally overwrites
  /// `NEW.server_sequence` with `nextval('sync_sequence')` before every
  /// write — including an UPDATE, so "an application UPDATE must re-assign
  /// server_sequence" (the rule P2.S1b would otherwise have to remember) is
  /// mechanically enforced rather than a convention.
  ///
  /// Do NOT go back to `@default(dbgenerated("nextval('sync_sequence')"))`
  /// here — verified against a real Postgres 17 container that this makes
  /// `prisma migrate diff --from-config-datasource --to-schema` (and, by the
  /// same mechanism, `migrate dev`'s own drift check) propose
  /// `DROP SEQUENCE "sync_sequence"` plus stripping this default on all
  /// three tables that carry one, because Prisma's diff engine cannot match
  /// a `dbgenerated()` string against Postgres's canonicalized
  /// `nextval('sync_sequence'::regclass)` and concludes the sequence and
  /// the defaults referencing it are unmanaged drift to remove. See this
  /// migration's own header comment and
  /// design-specs/data-model/p1-s3-schema-coverage.md "Role split" sibling
  /// section "Sync sequence assignment" for the verification.
  serverSequence BigInt @unique @default(0) @map("server_sequence")

  /// Tombstone (ADR-0001): NULL = alive. Never a hard DELETE — now mechanically,
  /// not just by write-path discipline (S6 review finding): the runtime
  /// role's grant on this table omits `DELETE` entirely. `Observation` and
  /// `EffectiveRange` below carry the same tombstone shape and the same
  /// grant restriction; not repeated per-model since there is nothing
  /// model-specific left to say once stated once. `Patient` and
  /// `SyncOperation` are deliberately NOT part of this — neither is a
  /// tombstoned, synced entity under ADR-0001, so their grant is untouched.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profiles")
}

// ===========================================================================
// Observations — FHIR R4 `Observation`, mirrored 1:1 (SRS §4.4, CLAUDE.md)
// ===========================================================================

/// FHIR R4 `Observation.status` value set, mirrored verbatim via `@map` so
/// the stored value round-trips byte-for-byte onto the wire with no
/// translation table in the export module. v1 write paths only ever need
/// FINAL (a normal entry) and ENTERED_IN_ERROR (SRS §3.6 edit/delete
/// history) — the rest exist so the column is genuinely the FHIR value set,
/// not a subset guessed at now and widened later by a migration.
enum ObservationStatus {
  REGISTERED       @map("registered")
  PRELIMINARY      @map("preliminary")
  FINAL            @map("final")
  AMENDED          @map("amended")
  CORRECTED        @map("corrected")
  CANCELLED        @map("cancelled")
  ENTERED_IN_ERROR @map("entered-in-error")
  UNKNOWN          @map("unknown")

  @@map("observation_status")
}

/// Stoma output, fluid intake, voided urine, and body weight all live here,
/// distinguished by `code` — never a separate table per entry type
/// (CLAUDE.md). Resting heart rate (LOINC 8867-4) lands in this same table
/// later; the coded components it needs (measurement source,
/// resting-conditions flag) and the urine color coded component are
/// deliberately NOT added by this migration — they arrive with their own
/// features (P3.S2 for urine color; heart rate is not yet scheduled) as
/// additive `ALTER TABLE` migrations, per the sprint's "deliberately
/// partial" instruction. Adding them speculatively now would be exactly the
/// kind of unexercised migration path this plan is trying to avoid.
///
/// `code` is plain LOINC-coded text, not a foreign key to `ValueSetMember`:
/// LOINC is an external, versioned code system this application does not
/// own or administer (unlike the admin-managed value sets below), so there
/// is nothing for a local FK to constrain against. Verified codes in use or
/// planned — see design-specs/data-model/fhir-rxnorm-integration.md for
/// sources:
///   - 79560-9  Fluid output gastrointestinal ostomy [Volume] Measured (stoma output)
///   - 9000-1   Fluid intake oral Measured (fluid intake)
///   - 9187-6   Urine output (voided urine, point-in-time)
///   - 29463-7  Body weight
///   - 8867-4   Heart rate (not yet written by any endpoint)
///
/// `method` carries the SNOMED CT "Estimation technique" code ONLY when the
/// entry was estimated (CLAUDE.md) — that code is still
/// TODO(code-unverified) (design-specs/data-model/fhir-rxnorm-integration.md).
/// NULL means either "measured" (the FHIR-idiomatic way to represent the
/// default case — no `method` needed to say a value was obtained the
/// ordinary way) or "not applicable" (weight, heart rate). Storage cannot
/// distinguish those two NULL reasons from each other, and per CLAUDE.md it
/// is not supposed to: the mandatory Measured/Estimated *selection* is a
/// Tier 1 write-time validation concern owned by `packages/core` (P1.S4)
/// and re-enforced server-side (P1.S5/P2.S1a), not a fact this table's shape
/// needs to recover after the fact.
model Observation {
  id String @id @map("id") @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Always the literal string "Observation" — enforced by a CHECK
  /// constraint in the migration, not by an enum, because this column
  /// exists to mirror the FHIR wire field name/value exactly (CLAUDE.md),
  /// not to model a set of choices.
  resourceType String @default("Observation") @map("resource_type")

  /// LOINC code. See the model doc comment above for the codes this
  /// migration verifies.
  code String @map("code")

  /// See the file-level "Numeric precision" note.
  /// NULLABLE since P3.S2, and only for voided urine.
  ///
  /// AC 12.1 AC2 lets a patient who cannot measure save a COLOUR ALONE, so
  /// this column has to admit absence. Four CHECK constraints in that
  /// migration keep the absence from spreading: a volume and its unit
  /// travel together; only code 9187-6 may omit the volume, and only with
  /// a colour; a colour appears on nothing else; and `method` cannot exist
  /// without a value to qualify.
  ///
  /// **Read paths must not treat NULL as zero.** `SUM()` skips it and
  /// application code that coerces it does not, and the two then disagree
  /// about a clinical total forever. A urine row with no volume is not a
  /// zero-volume void — it is an entry that recorded colour instead.
  valueQuantityValue Decimal? @map("value_quantity_value") @db.Decimal(12, 4)
  /// Canonical unit string, always "mL" or "kg" for the codes this
  /// migration covers (ADR-0004) — persisted on every row despite being
  /// derivable from `code`, because FHIR `valueQuantity.unit` requires it
  /// and an explicitly stored unit survives a future misinterpretation
  /// recoverable rather than guessed at. Enforced by a `CHECK (value IN
  /// ('mL', 'kg'))` in the migration (S4) — unlike the value-positivity
  /// CHECK below, a wrong unit is the failure mode that is silent
  /// everywhere else: every Daily Net Fluid Balance and weight-delta
  /// computation reading this row is simply wrong, with no error raised at
  /// any layer, whereas a negative volume is already caught by Tier 1
  /// validation and the positivity CHECK before this one would ever matter.
  valueQuantityUnit  String?  @map("value_quantity_unit")

  /// FHIR `Observation.effectiveDateTime` — the clinical moment the
  /// observation describes, entered and editable by the patient. Distinct
  /// from `clientUpdatedAt` below (when the write was made) and from
  /// `createdAt` (when the server first saw a row with this id).
  effectiveDatetime DateTime @map("effective_datetime") @db.Timestamptz(3)

  /// SNOMED CT "Estimation technique" code; NULL for measured/not-applicable.
  /// See the model doc comment above.
  method String? @map("method")

  /// The chosen step of the pale-to-dark urine colour scale, or NULL.
  ///
  /// A code from the app-native `urine_color` value set (seeded by the
  /// P3.S2 migration), never display text: the label a patient reads comes
  /// from the i18n catalog in `packages/core`, so there is one localization
  /// pipeline rather than two.
  ///
  /// App-native rather than a standard terminology because a pale-to-dark
  /// hydration chart is a patient-facing proxy, not a standard lab
  /// observation — the same reasoning that makes appliance changes and leak
  /// events ordinary relational tables.
  ///
  /// No foreign key to `value_set_members`, matching `fluidTypeCode` and for
  /// the same reason: members are retired and never deleted, so a stored
  /// code always resolves when rendering history.
  urineColorCode String? @map("urine_color_code")

  status ObservationStatus @default(FINAL) @map("status")

  /// P1.S4 finding (ADR-0005 follow-up): the schema stored only canonical
  /// mL/kg plus `Profile.measurementSystem`, which §3.10 explicitly lets a
  /// patient change — so ADR-0005's "round to a whole unit only when the
  /// display system differs from the ENTRY system" rule had no per-row
  /// source of truth to read `entrySystem` from.
  /// `convertVolumeForDisplay` in packages/core/src/units/convert.ts
  /// therefore takes `entrySystem` as a REQUIRED parameter it cannot
  /// actually be given yet; this column is what P2 write paths must supply
  /// so that parameter stops being unimplementable.
  ///
  /// Stores which of METRIC/IMPERIAL the value was ENTERED in — reusing the
  /// existing `measurement_system` enum (the same one `Profile
  /// .measurementSystem` uses), not the finer-grained entered unit
  /// (mL/oz/kg/lb). The unit is fully determined by this column plus
  /// `code` under ADR-0004's fixed code->canonical-unit mapping (a volume
  /// code is always mL-canonical, entered in mL or oz; a weight code is
  /// always kg-canonical, entered in kg or lb) and under §3.10's rule that
  /// mixed-system combinations are impossible to select — so a unit-level
  /// column would store no fact this one plus `code` doesn't already
  /// determine, at the cost of a second CHECK constraint cross-validating
  /// unit against code. `MeasurementSystemUnits` in packages/core is
  /// exactly this system value (`unitsForMeasurementSystem` turns it into
  /// the full unit pair `convertVolumeForDisplay` needs) — storing the
  /// system, not the unit, is what a P2 write path reads off this column
  /// with no translation step. What this forecloses: if a future
  /// measurement system ever needed a *unit* distinction this enum can't
  /// express (e.g. UK vs. US fluid ounces under one "imperial" label),
  /// this column does not carry that; it would need widening (a new enum
  /// value here is additive, but a genuinely different axis — same system,
  /// different unit — is not something this column was designed to hold).
  ///
  /// NOT NULL, for every code this table holds — including body weight and
  /// (once written) heart rate, not just the three volumetric codes
  /// ADR-0005's rounding rule is actually about. Two reasons this is not
  /// scoped narrower: (1) a NULL-means-"not applicable" convention already
  /// exists on `method` above and is flagged elsewhere in this schema as a
  /// wart worth not repeating — a column whose NULL can mean two different
  /// things depending on which row you're looking at is exactly the
  /// ambiguity a future reader has to rediscover by reading code, not the
  /// schema; (2) it is not actually true that only volumetric codes need
  /// it — a write path converting a patient-entered value (in whichever
  /// unit their current preference implies) into this table's canonical
  /// mL/kg has to know the entry system to do that conversion AT ALL,
  /// including for a weight entered in lb, so every write path already
  /// has this value in hand at insert time regardless of code. There is
  /// no default: with zero rows in this table today, `NOT NULL` costs
  /// nothing to add now and everything to retrofit once real rows exist
  /// with no recorded entry system to backfill from — see
  /// design-specs/data-model/p1-s3-schema-coverage.md and
  /// design-specs/data-model/fhir-rxnorm-integration.md for the full
  /// analysis and what P2.S1a's write path is obliged to do with it.
  ///
  /// Not a FHIR field. FHIR R4 `Observation` has no "entered measurement
  /// system" element — `valueQuantity.unit`/`.code` on the wire are always
  /// the canonical unit (ADR-0004), regardless of what this column says.
  /// This is app-native provenance the export module is not obliged to
  /// surface in a `Bundle` at all; see fhir-rxnorm-integration.md for
  /// whether/how a future export might carry it as a non-standard
  /// `extension`.
  enteredMeasurementSystem MeasurementSystem @map("entered_measurement_system")

  /// Which kind of fluid this was, for an INTAKE entry (LOINC 9000-1) — an
  /// app-native attribute, coded by the `fluid_type` value set and stored by
  /// its stable member code (CLAUDE.md: "Clinical records reference them by
  /// stable code, so a retired value must still resolve when rendering
  /// history").
  ///
  /// Nullable, and nullable for two different reasons that storage
  /// deliberately does not distinguish — the same shape `method` already has
  /// above. AC 2.3 AC1 makes the categorisation **optional** on an intake
  /// entry, so NULL there means "the patient did not say"; and it is
  /// meaningless on stoma output, urine, weight or heart rate, so NULL there
  /// means "not applicable". Which one a given NULL is follows from `code`.
  ///
  /// No foreign key to `value_set_members`, on purpose. Members are retired,
  /// never deleted, so the referential-integrity argument is already
  /// satisfied by that rule; and a FK would make this column's domain depend
  /// on a set an admin edits, so retiring a member would start failing writes
  /// of history that legitimately reference it.
  fluidTypeCode String? @map("fluid_type_code")

  /// The IANA time zone the device reported at the moment of entry
  /// (`America/Chicago`), and the calendar date that instant fell on in
  /// that zone (ADR-0016).
  ///
  /// ## Why a day needs storing at all
  ///
  /// `effectiveDatetime` is an instant. "Daily Net Fluid Balance" (SRS
  /// §3.5) is the headline hydration signal, "daily totals" drive anomaly
  /// highlighting (§3.9), and the composite status is computed per day
  /// (§3.12) — and the spec uses *daily* throughout without ever defining
  /// where a day starts. Grouping by the UTC day puts everything a patient
  /// at UTC-6 logs after 6pm into the next day, which splits a high-output
  /// ileostomy patient's evening output — the clinically interesting part,
  /// and the reason overnight dehydration is the risk — across two days
  /// neither they nor their clinician would recognise.
  ///
  /// ## Why it is captured, not derived
  ///
  /// Exactly the `entered_measurement_system` argument above, for exactly
  /// the same reason: patients travel and patients relocate, so a zone
  /// read from a mutable profile at render time is wrong precisely for the
  /// patients who moved. Client-asserted (`docs/sync-contract.md` §7.2) —
  /// only the device knows what the patient's clock said when they typed
  /// it in. The server validates that the zone resolves, nothing more.
  ///
  /// `NOT NULL` with no default, and permanent per row: the instant alone
  /// does not say where the patient was, so a row written without this can
  /// never have it recovered.
  ///
  /// ## Two columns, not one
  ///
  /// `local_date` is derived from the instant and the zone at write time
  /// and stored so daily aggregates can `GROUP BY` an indexed column
  /// rather than recomputing a zone conversion per row on the query that
  /// runs most.
  ///
  /// It is deliberately NOT monotonic with `effective_datetime`: a patient
  /// who crosses a zone can have a 23- or 25-hour day, and two rows can
  /// share an instant across different dates. Order by the instant; group
  /// by this. Code that assumes either implies the other is wrong.
  ///
  /// Neither is a FHIR field — same footing as
  /// `entered_measurement_system` above.
  enteredTimezone String   @map("entered_timezone") @db.VarChar(64)
  localDate       DateTime @map("local_date") @db.Date

  /// See Profile.clientUpdatedAt for what this is and is not used for.
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  /// See Profile.serverSequence for what this default is (and is not) and
  /// why.
  serverSequence  BigInt    @unique @default(0) @map("server_sequence")
  /// Tombstone (ADR-0001): NULL = alive. Never a hard DELETE.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Read patterns this covers: "this patient's entries of this code around
  // this time" (dashboard/history/physician view), and the delta-sync scan.
  // Composite, not the plain single-column index below duplicated: a delta
  // pull is always `WHERE patient_id = $1 AND server_sequence > $cursor
  // ORDER BY server_sequence`, which this index answers directly — a
  // separate `@@index([serverSequence])` alongside the `@unique` on the
  // same single column would be strict write-cost overhead with no read
  // this schema needs it for (S8).
  @@index([patientId, code, effectiveDatetime])
  @@index([patientId, serverSequence])
  /// The daily-aggregate index. Every "totals for a day" query groups by
  /// `local_date` (ADR-0016), and that is the query the patient dashboard
  /// and the physician view both run constantly — a sequential scan here
  /// is the one that shows up first.
  @@index([patientId, code, localDate])
  @@map("observations")
}

// ===========================================================================
// Sync (ADR-0001)
// ===========================================================================

/// Extensible on purpose: new entity types (appliance changes, leak events,
/// ...) get a new enum value in an additive migration when their table
/// lands, same as everything else in this sprint's "deliberately partial"
/// scope.
/// A logged meal (SRS §3.1, AC 2.4) — an **app-native** entity, not FHIR.
///
/// CLAUDE.md is explicit that this is the accepted trade-off of the
/// Postgres-over-FHIR-native decision: "App-native entities (appliance
/// changes, leak events, peristomal skin condition, reminders, Quick-Add
/// templates) have no FHIR equivalent and are ordinary relational tables."
/// A meal is one of those. FHIR has `NutritionIntake`, but it models a
/// prescribed or administered nutritional product with quantities and
/// nutrients — not "a free-text description of what someone ate, with a
/// relative size" — so mapping onto it would assert a conformance this row
/// does not have. The FHIR export module (P5) must NOT emit these as
/// `NutritionIntake`.
///
/// It is nonetheless a **synced** entity, so it carries the full ADR-0001
/// column set — `clientUpdatedAt` for last-write-wins, `serverSequence` for
/// the delta cursor, `deletedAt` for tombstones — identical in meaning to
/// `Observation`'s. Anything that differs here from that model is a bug.
model Meal {
  id String @id @map("id") @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// AC 2.4 AC1's free-text description. Optional: a patient who only taps
  /// quick-tags has still logged a meal, and forcing prose would make the
  /// tags pointless.
  ///
  /// Bounded at 2000 characters. Not a clinical limit — it is an unbounded
  /// patient-supplied string reaching a database, and `Patient.oidcSubject`
  /// records the same reasoning for the same reason.
  description String? @map("description") @db.VarChar(2000)

  /// AC 2.4 AC2. Mandatory, and therefore NOT NULL with no default: a
  /// default would record a size the patient never chose, and there is no
  /// way to tell that apart afterwards from a deliberate answer — the same
  /// argument `entered_measurement_system` (ADR-0012) and the
  /// Measured/Estimated toggle both make.
  size MealSize @map("size")

  /// AC 2.4 AC1's optional quick-tags, held as the `meal_tag` value set's
  /// stable member codes.
  ///
  /// An array column rather than a join table, deliberately. The join table
  /// is the better relational shape in isolation, but tags would then be rows
  /// with their own identity that must sync alongside the meal — and
  /// docs/sync-contract.md has no concept of a nested or dependent entity, so
  /// it would mean either a second synced entity type whose ordering relative
  /// to its parent is undefined, or a bespoke exception to the wire contract.
  /// Carrying them in the meal's own payload keeps one entity, one operation,
  /// one conflict resolution.
  ///
  /// The trade is no referential integrity to `value_set_members`. That is
  /// the same trade `Observation.fluidTypeCode` makes, for the same reason:
  /// members are retired and never deleted, so a stored code always resolves.
  /// GIN-indexed below, because "which meals carry this tag" is the dietary
  /// trigger analysis the tags exist for (SRS §3.1).
  tagCodes String[] @map("tag_codes")

  /// The clinical moment — when the meal was eaten, not when it was logged.
  effectiveDatetime DateTime @map("effective_datetime") @db.Timestamptz(3)

  /// ADR-0016, identical in meaning to `Observation`'s pair: the zone the
  /// device reported at entry, and the calendar date that instant fell on in
  /// that zone. Derived once at write time from the shared helper, never
  /// re-derived from a mutable profile or the reader's timezone.
  enteredTimezone String   @map("entered_timezone") @db.VarChar(64)
  localDate       DateTime @map("local_date") @db.Date

  /// See Profile.clientUpdatedAt. Last-write-wins input; never createdAt.
  clientUpdatedAt DateTime @map("client_updated_at") @db.Timestamptz(3)

  /// The shared cross-table `sync_sequence`, so a delta cursor is comparable
  /// across entity types rather than only within this one.
  serverSequence BigInt    @unique @default(0) @map("server_sequence")
  /// Tombstone (ADR-0001): NULL = alive. Never a hard DELETE.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([patientId, effectiveDatetime])
  @@index([patientId, serverSequence])
  /// The daily-aggregate index, matching `observations` — meals are grouped
  /// by the patient's local day everywhere they are shown.
  @@index([patientId, localDate])
  /// The dietary-trigger-analysis index (SRS §3.1). GIN, not btree: the query
  /// is array containment ("which meals carry this tag"), which btree cannot
  /// serve. Named explicitly so the schema and the migration agree — Prisma's
  /// default name would be `meals_tag_codes_idx`, and a name mismatch shows up
  /// as permanent drift rather than as an error.
  @@index([tagCodes], type: Gin, map: "meals_tag_codes_gin_idx")
  @@map("meals")
}

enum SyncEntityType {
  PROFILE
  OBSERVATION
  EFFECTIVE_RANGE
  /// P3.S1. A new `entityType` is additive under docs/sync-contract.md §8 and
  /// needs no version bump — but a client that does not know it must never be
  /// SENT one, which is why the delta endpoint filters by what the requesting
  /// client can accept rather than returning everything it holds.
  MEAL

  @@map("sync_entity_type")
}

/// AC 2.4 AC2's mandatory relative size modifier.
///
/// A relative scale, not a quantity: the AC asks for Small/Snack,
/// Medium/Standard, Large/Heavy, which is what a patient can actually judge
/// about a meal they have just eaten. Deliberately NOT grams or calories —
/// this application does not ask patients to weigh food, and a numeric column
/// here would invite someone to start.
///
/// An enum rather than a value set because it is a fixed ordinal scale the
/// application reasons about, not an admin-editable list. Adding a step would
/// change what every stored value means relative to the others, which is a
/// migration and a clinical decision, not configuration (contrast
/// `meal_tag`, which IS a value set precisely because it grows).
enum MealSize {
  SMALL
  MEDIUM
  LARGE

  @@map("meal_size")
}

enum SyncOperationType {
  CREATE
  UPDATE
  DELETE

  @@map("sync_operation_type")
}

enum SyncOperationStatus {
  ACCEPTED
  REJECTED
  /// Valid, processed, and deliberately NOT applied: a newer version of the
  /// same entity already existed, so this operation lost last-write-wins
  /// (docs/sync-contract.md §3.5, §4). Added at P2.S1b.
  ///
  /// A third value rather than a flavour of ACCEPTED, because collapsing it
  /// would make "this operation lost a conflict" recoverable only by
  /// correlating against the audit log. It is also not REJECTED: there is
  /// nothing for the patient to correct, and routing it to the correction
  /// inbox asks them to fix an entry that was never wrong.
  SUPERSEDED

  @@map("sync_operation_status")
}

/// The append log a push batch writes to. Building the push/pull handlers
/// that populate and read this table is P2.S1b's job; this migration only
/// provides the storage shape.
///
/// `id` is a server-generated surrogate key, deliberately NOT the
/// client-generated per-operation UUID (S7 review finding; reversed from
/// this migration's original design, which made the client-chosen UUID the
/// PK directly). `operationId` below carries that client-generated value
/// instead. Why the split: the per-operation UUID is chosen by an
/// untrusted, offline device and is not patient-scoped by construction — a
/// malicious or buggy client could choose an `operationId` that collides
/// with a value some *other* patient's device already used, and if that
/// value were the table's own globally-unique PK, patient A's write could
/// cause patient B's legitimate, distinct push to be rejected as a replay
/// of A's. Scoping the idempotency check to `@@unique([patientId,
/// operationId])` closes that: the same `operationId` is only ever
/// compared for replay purposes within one patient's own operation stream.
/// A push/pull handler (P2.S1b) must always look up an incoming operation
/// by `(patientId, operationId)` together — a lookup by `operationId` alone
/// is exactly the bug this shape exists to make impossible to write by
/// accident.
model SyncOperation {
  /// Internal surrogate primary key. Never the idempotency key — see
  /// `operationId` below and the model doc comment above.
  id String @id @default(uuid()) @map("id") @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// The per-operation UUID, CLIENT-GENERATED at enqueue time (ADR-0001
  /// point 1) — deliberately NOT the entity UUID, so a replayed push of the
  /// same operation is recognizable as the same write attempt regardless of
  /// how many times the entity itself has since been updated. This is the
  /// idempotency key, but only in combination with `patientId` — see the
  /// model doc comment above (S7).
  operationId String @map("operation_id") @db.Uuid

  entityType    SyncEntityType    @map("entity_type")
  entityId      String            @map("entity_id") @db.Uuid
  operationType SyncOperationType @map("operation_type")

  /// The client-asserted write timestamp this operation carries — sync
  /// applies a batch in strict client-timestamp order (ADR-0001 point 6)
  /// and this is what that ordering is over.
  clientTimestamp DateTime @map("client_timestamp") @db.Timestamptz(3)
  /// Server receipt time — bookkeeping/debugging only, never ordering.
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  status                SyncOperationStatus @map("status")
  /// Machine-readable reason code and offending field (ADR-0001 point 2).
  /// Never the offending clinical value (ADR-0001 "Compliance and safety
  /// review") — enforcing that is the API layer's job (P2.S1b), not a
  /// constraint this column can express.
  /// Free text at the database level; a CLOSED set at the API level. The
  /// wire types (`packages/core/src/sync`) close both of these, storage
  /// cannot, and §3.7's byte-for-byte replay guarantee is served from these
  /// columns — so a value outside the closed set would be replayed to the
  /// client verbatim forever. `sync.integration.spec.ts` asserts every
  /// stored `rejection_field` is a member of `SYNC_FIELD_PATH`, which is the
  /// test §3.5 owed this sprint.
  rejectionReasonCode   String?             @map("rejection_reason_code")
  rejectionField        String?             @map("rejection_field")
  /// The entity row's `serverSequence` as it stands after this operation was
  /// processed. Present for ACCEPTED **and SUPERSEDED**, NULL only for
  /// REJECTED (docs/sync-contract.md §3.6 — the comment previously said
  /// "NULL when rejected" while describing only the accepted case; widened
  /// at P2.S1b alongside the SUPERSEDED enum value).
  ///
  /// For SUPERSEDED it is the WINNING row's sequence, not this operation's —
  /// this operation never got one, because it was never applied. That is
  /// what makes it useful to the loser: it names the version that beat it.
  ///
  /// A receipt, never a cursor (§3.6): it reports where one row landed,
  /// while a delta cursor asserts every row up to that point has been seen.
  /// Lets a client confirm which sync_sequence value its own write landed at
  /// without a second round trip.
  appliedServerSequence BigInt?             @map("applied_server_sequence")

  @@unique([patientId, operationId])
  @@index([patientId, clientTimestamp])
  @@index([entityType, entityId])
  @@map("sync_operations")
}

// ===========================================================================
// Audit (SRS §5.2, ADR-0011) — append-only by DATABASE GRANT, not convention
// ===========================================================================

/// Distinguishes a patient PHI action from an admin configuration change
/// (SRS §3.11, §5.2: both land in this same append-only store) and reserves
/// a SYSTEM value for a server-initiated write with no human actor (e.g. a
/// scheduled job) — none of the sprints so far produce one, but adding the
/// value later would be no less additive than adding it now, and the
/// column would otherwise need a nullable actorType to mean "none of the
/// above", which is worse.
enum AuditActorType {
  PATIENT
  ADMIN
  SYSTEM

  @@map("audit_actor_type")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// Append-only. `SELECT` and `INSERT` are the only grants the runtime role
/// holds — no
/// `UPDATE`/`DELETE` grant exists anywhere, in any environment, for this
/// table (ADR-0011); see the migration's GRANT statements, and B3/B4 in the
/// review response for why "the runtime role's grants are correct" and "the
/// runtime role's attributes are what this schema assumes" are two
/// different claims, only the first of which this table's grants alone can
/// prove. There is deliberately no `@@relation` to `Patient`: this table
/// must go on resolving `entityId` values (patients, profiles, observations,
/// admin config rows, and whatever arrives in later sprints) after the PHI
/// retention/deletion policy — still pending legal counsel per ADR-0001's
/// "Notes" — is decided, and a hard FK would force that decision now by
/// however its `onDelete` behavior is chosen. `entityId` is plain text, not
/// `@db.Uuid`, because not every referenced id is UUID-shaped: an admin
/// config row's id is, but a future config-key-only entity might not be.
/// (Before S1, this comment additionally justified plain text by
/// `Patient.id` being an OIDC subject; that is no longer true —
/// `Patient.id` is a UUID like everything else — but the column stays plain
/// text for the reason above.)
model AuditEvent {
  id String @id @default(uuid()) @map("id") @db.Uuid

  actorType AuditActorType @map("actor_type")
  /// The JWT subject of the patient or admin who made the change. No other
  /// claim is ever carried onto this row (docs/security-hipaa.md "Never log
  /// PHI"; see also PatientActor's own doc comment on why only `id` is kept
  /// off a verified token in the first place). Bounded the same way and for
  /// the same reason as `Patient.oidcSubject` (S2): fed directly from an
  /// unvalidated bearer-token claim.
  actorId   String         @map("actor_id") @db.VarChar(255)

  action     AuditAction @map("action")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")

  /// e.g. 'direct_write' | 'sync_applied' | 'sync_conflict_loser' |
  /// 'admin_config_change'. Free text rather than an enum for the same
  /// reason `Observation.code` and every `rangeType`/`thresholdKey` below
  /// are: new write paths (P2.S1b's sync conflict handling, P1.S5's
  /// interceptor, P3.S3's admin API) add new reason strings without a
  /// schema migration. The two ADR-0001 call-outs that must exist once
  /// P1.S5/P2.S1b land are 'sync_applied' and 'sync_conflict_loser' — the
  /// two write paths that are "the ones that get missed" per that ADR.
  reasonCode String? @map("reason_code")

  /// The request (or sync batch) this row belongs to.
  ///
  /// Nullable because not every audited write has a request: ADR-0001's
  /// last-write-wins conflict LOSER is audited without one, and so is any
  /// future scheduled or queue-driven write. NULL means "no originating
  /// request", never "we forgot" — a write that has a correlation id must
  /// supply it.
  ///
  /// P1.S5 shipped this value nested inside `beforeValue`/`afterValue` JSON
  /// because that sprint could not touch prisma/. Review flagged that those
  /// rows can never be normalised — `audit_events` has no UPDATE grant by
  /// design (ADR-0011) — so the column lands here while the only wrapped
  /// rows are synthetic test scaffolding. After P2.S1a it would have been
  /// permanent.
  ///
  /// Indexed because the query that reads it back runs under a breach
  /// notification clock: "reconstruct everything that happened in request
  /// X" must not be a sequential scan of the largest table in the system.
  correlationId String? @map("correlation_id") @db.VarChar(255)

  beforeValue Json? @map("before_value")
  afterValue  Json? @map("after_value")

  /// Server-set, not merely server-defaulted (S3): a `BEFORE INSERT`
  /// trigger (`assign_audit_event_occurred_at`, in the migration)
  /// unconditionally overwrites this column with `now()`, regardless of
  /// what value — if any — an INSERT statement supplies. NOT enforced by a
  /// column-scoped `GRANT INSERT` excluding this column, which was the
  /// original design here: verified empirically that Prisma ORM 7's
  /// generated client computes `@default(now())` client-side and sends
  /// `occurred_at` explicitly on every `auditEvent.create()` call,
  /// including ones that never set it — a column-scoped grant would have
  /// rejected that ordinary, legitimate call, not just a deliberate
  /// backdating attempt. The trigger achieves the same guarantee (the
  /// stored value can never be influenced by caller-supplied input) by a
  /// mechanism that does not depend on which column list happens to appear
  /// in whichever INSERT statement writes this row.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

// ===========================================================================
// Configuration surface (SRS §3.11, §4.4) — outside the PHI boundary
// ===========================================================================

enum ValueSetMemberStatus {
  ACTIVE
  RETIRED

  @@map("value_set_member_status")
}

/// A named category of admin-managed codes (e.g. 'output_consistency',
/// 'fluid_type', 'meal_quick_tag', 'leak_suspected_cause',
/// 'peristomal_skin_severity', 'appliance_type', 'urine_color',
/// 'heart_rate_measurement_source' — SRS §3.11). Only the two members this
/// sprint's slice can plausibly need are seeded by anything (nothing —
/// seeding is P2.S4); this migration creates the table shape only.
model ValueSet {
  id String @id @default(uuid()) @map("id") @db.Uuid

  /// The stable slug admin tooling and application code both address this
  /// set by (e.g. "urine_color"). Distinct from `ValueSetMember.code`
  /// below — this is the set's own key, not a member's.
  key         String  @unique @map("key")
  /// Admin-tool label only. Patient-facing copy/terminology display labels
  /// are explicitly NOT managed here (SRS §3.11) — they stay in the
  /// externalized i18n string catalog (packages/core, P1.S4) so there is
  /// exactly one localization pipeline, not two. Do not add a display/label
  /// column to this model or to ValueSetMember for that reason.
  description String? @map("description")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members ValueSetMember[]

  @@map("value_sets")
}

/// Retired, never deleted (SRS §3.11, CLAUDE.md): `status` is the only
/// mechanism for removing a member from future pickers. Clinical rows
/// reference a member by `code` (a plain string on whichever clinical
/// table needs it — no such column exists yet in this sprint's scope), so a
/// retired code must keep resolving here forever; nothing in this schema,
/// and no future migration, may delete a row from this table or reassign
/// its `code` to a different concept.
///
/// Now mechanically enforced (S5 review finding — this migration
/// originally left it as application/admin-tool discipline only, the same
/// as every "ordinary" table): the runtime role's grant on this table omits
/// `DELETE`, and a `BEFORE UPDATE` trigger
/// (`forbid_value_set_member_code_change`, in the migration) raises if
/// `OLD.code IS DISTINCT FROM NEW.code`. `UPDATE ... SET code = ...` is
/// worse than a delete here — it silently re-labels every historical
/// clinical entry that already referenced the old code, with nothing to
/// trace it by until admin-side audit logging exists (P3.S3) — so the
/// trigger, not just the missing `DELETE` grant, is load-bearing. A
/// compromised owner could disable the trigger, but the threat model this
/// closes is an application bug, not a compromised owner (that is exactly
/// what the `DELETE`-grant half of ADR-0011's own model already accepts for
/// `audit_events`).
model ValueSetMember {
  id String @id @default(uuid()) @map("id") @db.Uuid

  valueSetId String   @map("value_set_id") @db.Uuid
  valueSet   ValueSet @relation(fields: [valueSetId], references: [id], onDelete: Restrict)

  /// Stable, never reused after retirement (by discipline — see model doc
  /// comment above).
  code   String               @map("code")
  status ValueSetMemberStatus @default(ACTIVE) @map("status")

  sortOrder Int @default(0) @map("sort_order")

  /// An optional quantity carried BY the member itself, in `numericUnit`.
  ///
  /// Added at P3.S1 for AC 2.3 AC2's "configurable quick-select buttons for
  /// standard container sizes": a 250 mL glass is a member whose *code* is a
  /// stable identifier (`glass_250`) and whose *volume* is data an admin can
  /// change. Neither `code` nor `sortOrder` can hold it — encoding the number
  /// into the code would make changing the volume a code change, and a code
  /// change is what CLAUDE.md forbids ("No admin action may change what a past
  /// entry means").
  ///
  /// Nullable because most value sets have no quantity at all: a fluid type or
  /// a meal tag is a category, not a measurement. `DECIMAL(12,4)` matches
  /// `observations.value_quantity_value`, so a container size can be written
  /// into that column without a representability question (ADR-0005).
  ///
  /// `numericUnit` is stored beside it rather than assumed from the set,
  /// because the same reasoning that made `ThresholdsService` verify a
  /// threshold's `unit` applies here: an admin editing 250 mL to 250 with the
  /// unit left as something else is an administratively plausible mistake, and
  /// a value with no unit beside it is one a reader has to guess about.
  numericValue Decimal?  @map("numeric_value") @db.Decimal(12, 4)
  numericUnit  String?   @map("numeric_unit")
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([valueSetId, code])
  @@map("value_set_members")
}

/// Admin-managed default range tables (SRS §3.9, §3.11) keyed to ostomy
/// type and post-operative window, seeding the Section 3.9 suggestions.
/// `rangeType` and `unit` are plain strings, not enums — the set of ranges
/// this drives grows with each later phase (weight, then heart rate, then
/// whatever comes after) and none of those additions should require a
/// migration to this table.
model ClinicalDefaultRange {
  id String @id @default(uuid()) @map("id") @db.Uuid

  ostomyType OstomyType @map("ostomy_type")
  /// e.g. 'daily_output_ml', 'net_fluid_balance_ml',
  /// 'urine_output_adequacy_ml', 'weight_change_threshold_percent',
  /// 'resting_heart_rate_elevation_bpm', 'orthostatic_postural_rise_bpm'.
  rangeType  String     @map("range_type")

  /// Inclusive post-operative day window this default applies to. NULL
  /// `maxDaysPostOp` means unbounded ("3 months and beyond").
  minDaysPostOp Int? @map("min_days_post_op")
  maxDaysPostOp Int? @map("max_days_post_op")

  lowValue  Decimal? @map("low_value") @db.Decimal(12, 4)
  highValue Decimal? @map("high_value") @db.Decimal(12, 4)
  unit      String   @map("unit")

  /// Rolling-window length in days, where the range type is windowed
  /// (weight/heart-rate baselines per §3.12/§3.13). NULL where not
  /// applicable (e.g. a flat daily-output ceiling).
  windowDays Int? @map("window_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ostomyType, rangeType])
  @@map("clinical_default_ranges")
}

/// Not clinical (Tier 1/Tier 2) validation tiers only: `SAFETY_THRESHOLD`
/// covers the heart-rate red-flag bound (SRS §3.8, §3.9 — explicitly NOT a
/// validation concern, and the one threshold that is not patient-adjustable)
/// and `OPERATIONAL` covers non-clinical admin-managed config that still
/// must not be a code constant, such as the sync clock-skew allowance
/// (ADR-0001 point 5).
enum ValidationTier {
  TIER_1_HARD_BLOCK
  TIER_2_SOFT_WARNING
  SAFETY_THRESHOLD
  OPERATIONAL

  @@map("validation_tier")
}

/// The numeric bounds behind SRS §3.8's tiers, §3.9's suggestion basis, and
/// ADR-0001's clock-skew allowance — all admin-managed, never a constant in
/// `packages/core` or the API (CLAUDE.md "Validation"). `thresholdKey` is
/// the stable lookup key `packages/core`'s threshold-injection interface
/// (P1.S4) and `ThresholdsService` (P1.S5) read; e.g.
/// 'stoma_output_single_entry_warning_ml',
/// 'stoma_output_absolute_ceiling_ml', 'weight_day_over_day_change_percent',
/// 'heart_rate_red_flag_bpm', 'sync_clock_skew_allowance_seconds'.
model ValidationThreshold {
  id String @id @default(uuid()) @map("id") @db.Uuid

  thresholdKey String         @unique @map("threshold_key")
  tier         ValidationTier @map("tier")

  value Decimal @map("value") @db.Decimal(12, 4)
  unit  String? @map("unit")

  /// False only for the heart-rate red-flag threshold today (SRS §3.9).
  patientAdjustable Boolean @default(true) @map("patient_adjustable")

  /// Admin-tool label only — see ValueSet.description for why this is not
  /// patient-facing copy.
  description String? @map("description")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("validation_thresholds")
}

/// SRS §3.9 precedence, highest first: PHYSICIAN_SET, PATIENT_SET,
/// PATIENT_CONFIRMED_SUGGESTION, CLINICAL_DEFAULT. Enum declaration order
/// mirrors that precedence for readability; nothing in Postgres enforces
/// ordering from declaration order alone — precedence is a query/business
/// rule for whichever sprint reads this table (not yet built), not a
/// constraint this schema can express by itself.
enum RangeProvenance {
  PHYSICIAN_SET
  PATIENT_SET
  PATIENT_CONFIRMED_SUGGESTION
  CLINICAL_DEFAULT

  @@map("range_provenance")
}

/// This is the field that makes "an unconfirmed suggestion is never an
/// active anomaly threshold" (CLAUDE.md) a queryable fact rather than
/// something inferred from provenance + a nullable timestamp: anomaly
/// flagging (not built yet) filters `WHERE status = 'ACTIVE'`, full stop.
/// PROPOSED rows are suggestions awaiting patient confirmation (SRS §3.9:
/// "No value becomes an active threshold without a human confirming it") —
/// persisted, not ephemeral, because Preferences (§3.10) must be able to
/// list "pending suggested adaptations awaiting confirmation". DISMISSED
/// records that the patient was shown a suggestion and kept the current
/// value instead (§3.9), rather than deleting the row.
enum RangeStatus {
  PROPOSED
  ACTIVE
  SUPERSEDED
  DISMISSED

  @@map("range_status")
}

/// A patient's effective range, with provenance (SRS §3.9, §4.4). This IS a
/// synced entity: today, every provenance value is initiated by a patient
/// action (accepting/editing a suggestion, or entering a value the SRS
/// notes "a future physician portal" may one day set directly) — see
/// Profile's doc comment for what the sync bookkeeping columns below mean.
///
/// No partial-unique-index enforcement of "at most one ACTIVE row per
/// (patientId, rangeType)" in this migration — see
/// design-specs/data-model/p1-s3-schema-coverage.md for why that was left
/// out deliberately rather than guessed at.
model EffectiveRange {
  id String @id @map("id") @db.Uuid

  patientId String  @map("patient_id") @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  /// Same key space as ClinicalDefaultRange.rangeType.
  rangeType String @map("range_type")

  lowValue    Decimal? @map("low_value") @db.Decimal(12, 4)
  highValue   Decimal? @map("high_value") @db.Decimal(12, 4)
  /// For single-target ranges (e.g. target dry weight) rather than a
  /// low/high band.
  targetValue Decimal? @map("target_value") @db.Decimal(12, 4)
  unit        String   @map("unit")

  provenance RangeProvenance @map("provenance")
  status     RangeStatus     @default(ACTIVE) @map("status")

  /// Self-relation linking a confirmed or superseding row back to the
  /// suggestion/value it replaced, so "why did this change" (§3.9
  /// adaptation) has an answer without reconstructing it from
  /// AuditEvent.beforeValue/afterValue. Nullable: the very first range for
  /// a given (patient, rangeType) has nothing to point at.
  previousRangeId String?          @map("previous_range_id") @db.Uuid
  previousRange   EffectiveRange?  @relation("EffectiveRangeHistory", fields: [previousRangeId], references: [id], onDelete: Restrict)
  supersededBy    EffectiveRange[] @relation("EffectiveRangeHistory")

  /// See Profile.clientUpdatedAt.
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  /// See Profile.serverSequence for what this default is (and is not) and
  /// why.
  serverSequence  BigInt    @unique @default(0) @map("server_sequence")
  /// Tombstone (ADR-0001): NULL = alive. Never a hard DELETE.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([patientId, rangeType, status])
  // The delta-pull read pattern (S8) — see the matching index comment on
  // Observation above.
  @@index([patientId, serverSequence])
  @@map("effective_ranges")
}
