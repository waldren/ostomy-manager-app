# Environment variables for @ostomy/api.
#
# Placeholders only — scripts/check-no-committed-env.sh scans this file for
# anything that looks like a real credential and fails CI if it finds one.
# Copy to .env locally; never commit .env (see docs/security-hipaa.md).

# --- Server -----------------------------------------------------------------

NODE_ENV=development
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Patient OIDC -------------------------------------------------------------
# Standard OIDC issuer/JWKS/audience configuration. In development this
# points at the mock-oauth2-server container (P1.S2); in production it points
# at the patient Cognito user pool. The API never imports a Cognito SDK — see
# docs/security-hipaa.md "Provider-agnostic auth and storage".

OIDC_ISSUER=http://localhost:8090/patient-issuer
OIDC_JWKS_URI=http://localhost:8090/patient-issuer/jwks
OIDC_AUDIENCE=ostomy-patient-app
# Which JWT claim carries the caller's stable identifier. Defaults to "sub"
# if unset; override for a provider that puts it elsewhere (e.g. a custom
# Cognito claim).
OIDC_SUBJECT_CLAIM=sub

# --- Admin OIDC ---------------------------------------------------------------
# A structurally separate identity pool (SRS_v2 §4.6, ADR-0008). Must never
# share an issuer or audience with the patient values above — that separation
# is what makes the admin/patient boundary an identity-layer property rather
# than an authorization check.

ADMIN_OIDC_ISSUER=http://localhost:8090/admin-issuer
ADMIN_OIDC_JWKS_URI=http://localhost:8090/admin-issuer/jwks
ADMIN_OIDC_AUDIENCE=ostomy-admin-console
ADMIN_OIDC_SUBJECT_CLAIM=sub

# --- Object storage -----------------------------------------------------------
# S3-compatible endpoint config. In development this is MinIO (path-style
# addressing required); in production it is AWS S3.

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
# true for MinIO (development); false for AWS-hosted S3.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
