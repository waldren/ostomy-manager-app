# Environment variables for @ostomy/api.
#
# Placeholders only. scripts/check-no-committed-env.sh scans this file
# against a fixed prefix list (AWS/GitHub/Slack/Stripe-shaped keys, a JWT,
# a PEM private-key header, credentials embedded in a URL) and fails CI on
# a match — a fast, dependency-free tripwire for THOSE shapes, not a
# general credential scanner; a real password matches none of them. Copy
# to .env locally; never commit .env (see docs/security-hipaa.md).

# --- Server -----------------------------------------------------------------

NODE_ENV=development
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Clock-skew tolerance (seconds) applied to JWT exp/iat/nbf checks in both
# OIDC guards. jose defaults to zero; Fargate host clocks and mobile-device
# clocks both drift. Not clinical, so not admin-managed configuration.
OIDC_CLOCK_TOLERANCE_SECONDS=30

# --- Database (P1.S3) ---------------------------------------------------------
# The RUNTIME role's DSN ONLY (ADR-0011) — this app never connects as the
# migration/owner role. Standard form:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# The placeholder below deliberately does NOT write that form literally —
# scripts/check-no-committed-env.sh's credential tripwire matches any
# `scheme://word:word@` shape on sight (by design: it cannot tell a real
# embedded password from a fake one, so it flags the shape itself), and
# this file must stay placeholder-only, not merely real-secret-free. The
# user is `ostomy_runtime` — must match the literal role name the first
# migration creates
# (apps/api/prisma/migrations/20260905000000_init_schema_core/migration.sql);
# the password is whatever infra/db/bootstrap-roles.sql (or, outside
# Docker, a manual `ALTER ROLE ... WITH LOGIN PASSWORD ...`) set it to —
# see infra/docker-compose.yml's `db-roles` service and .env at the repo
# root for the Compose stack's own values.
DATABASE_URL=postgresql://ostomy_runtime@replace-with-a-local-only-postgres-password-in-the-url-above

# The OWNER/migration role's DSN — read only by apps/api/prisma.config.ts,
# i.e. only by `prisma` CLI invocations (`migrate dev`, `migrate diff`,
# `db execute`, ...) run directly against this checkout. Never read by the
# running API (src/config/env.schema.ts has no field for it) — do not set
# this in the same .env file you use for `pnpm --filter @ostomy/api
# start:dev` unless you genuinely also intend to run migration CLI commands
# from that same shell. Deliberately a DIFFERENT variable name than
# DATABASE_URL above (S12): giving both DSNs the same name is what let a
# root .env holding the owner DSN under "DATABASE_URL" for CLI convenience
# silently make `start:dev` run the whole API as the schema owner, with
# none of ADR-0011's grant restrictions in effect. The user is
# `ostomy_owner` in this repo's own dev stack (POSTGRES_USER in the root
# .env.example) — a superuser, per ADR-0011's accepted development-only gap.
# MIGRATION_DATABASE_URL=postgresql://ostomy_owner@replace-with-a-local-only-postgres-password-in-the-url-above

# --- Patient OIDC -------------------------------------------------------------
# Standard OIDC issuer/JWKS/audience configuration. In development this
# points at the mock-oauth2-server container (P1.S2); in production it points
# at the patient Cognito user pool. The API never imports a Cognito SDK — see
# docs/security-hipaa.md "Provider-agnostic auth and storage".

OIDC_ISSUER=http://localhost:8090/patient-issuer
OIDC_JWKS_URI=http://localhost:8090/patient-issuer/jwks
OIDC_AUDIENCE=ostomy-patient-app
# Which JWT claim carries the caller's stable identifier. Defaults to "sub"
# if unset; override for a provider that puts it elsewhere (e.g. a custom
# Cognito claim).
OIDC_SUBJECT_CLAIM=sub

# --- Admin OIDC ---------------------------------------------------------------
# A structurally separate identity pool (SRS_v2 §4.6, ADR-0008). Must never
# share an issuer or audience with the patient values above — that separation
# is what makes the admin/patient boundary an identity-layer property rather
# than an authorization check.

ADMIN_OIDC_ISSUER=http://localhost:8090/admin-issuer
ADMIN_OIDC_JWKS_URI=http://localhost:8090/admin-issuer/jwks
ADMIN_OIDC_AUDIENCE=ostomy-admin-console
ADMIN_OIDC_SUBJECT_CLAIM=sub


# ---------------------------------------------------------------------------
# Sync transport bounds (docs/sync-contract.md §3.3, §5.1)
# ---------------------------------------------------------------------------
# Transport bounds, not clinical thresholds — an admin lowering the batch size
# changes how many operations fit in one request, not what counts as a
# plausible stoma output. The clinical sibling,
# `sync_clock_skew_allowance_seconds`, is deliberately NOT here: §3.8 makes it
# an admin-managed `validation_thresholds` row, because it and
# packages/core's `maxClockSkewMs` must derive from one row.
#
# All three have defaults and may be omitted.
# A `limit` above SYNC_DELTA_MAX_LIMIT is clamped, never refused (§5.1): a 400
# would permanently brick any fielded client whose hardcoded page size the
# server later lowered.
SYNC_PUSH_MAX_OPERATIONS=500
SYNC_DELTA_DEFAULT_LIMIT=200
SYNC_DELTA_MAX_LIMIT=1000
# --- Object storage -----------------------------------------------------------
# S3-compatible endpoint config. In development this is MinIO (path-style
# addressing required); in production it is AWS S3.
#
# NOTE for standalone use (this file, `pnpm --filter @ostomy/api start:dev`,
# API running outside Docker): infra/docker-compose.yml publishes only
# MinIO's console (9001) to the host by default — the S3 API port (9000)
# below is compose-network-only, reachable from other containers as
# http://minio:9000 but not from the host. Temporarily add `"9000:9000"` to
# the `minio` service's `ports:` (and revert afterward) to use MinIO this
# way; otherwise point this at a MinIO you're running some other way.

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
# true for MinIO (development); false for AWS-hosted S3.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
