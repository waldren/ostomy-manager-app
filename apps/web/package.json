{
  "name": "@ostomy/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Patient-facing web SPA (React + Vite). Online-only by explicit decision (SRS_v2 §4.2/§4.3) — no local persistence layer, no offline queue.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ostomy/core": "workspace:*",
    "@ostomy/ui": "workspace:*",
    "i18next": "^25.7.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.3.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@ostomy/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  }
}
