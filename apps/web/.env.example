# Environment variables for @ostomy/web.
#
# Vite only exposes variables prefixed VITE_ to client code; nothing here is
# a secret (a public SPA client cannot hold one) — the PKCE flow this app
# uses (apps/web/src/auth) exists specifically so no client secret is
# needed. Copy to .env.local for local development; never commit .env.local.

# Standard OIDC issuer. Discovery is fetched from
# ${VITE_OIDC_ISSUER}/.well-known/openid-configuration — see
# apps/web/src/auth/discovery.ts. In development this points at the
# mock-oauth2-server container's patient issuer (apps/api/.env.example's
# OIDC_ISSUER); in production it points at the patient Cognito user pool's
# hosted UI domain.
VITE_OIDC_ISSUER=http://localhost:8090/patient-issuer

# This SPA's own registered OIDC client id — distinct from
# apps/api/.env.example's OIDC_AUDIENCE (the API's resource identifier).
VITE_OIDC_CLIENT_ID=ostomy-web

# Must exactly match a redirect URI registered with the issuer, and must be
# a route this app actually handles — the app root, so the callback lands
# on the (auth-guarded) physician view rather than an unmatched route.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# Origin the API is served from, no trailing slash.
VITE_API_BASE_URL=http://localhost:3000
