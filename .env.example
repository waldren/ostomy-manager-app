# Environment variables for the shared on-premise development stack
# (infra/docker-compose.yml). See docs/deployment-development.md.
#
# Placeholders only. scripts/check-no-committed-env.sh scans this file
# against a fixed prefix list (AWS/GitHub/Slack/Stripe-shaped keys, a JWT,
# a PEM private-key header, credentials embedded in a URL) and fails CI if
# it finds a match — it is a fast, dependency-free tripwire for THOSE
# shapes, not a general "does this look like a real credential" scanner. A
# real Postgres or MinIO password, which is exactly what this file's
# placeholders stand in for, matches none of those patterns and would pass
# silently; do not rely on this script to catch one. Copy to `.env` at the
# repo root on the dev host and fill in real (still low-value,
# synthetic-data-only) values; never commit `.env`.
#
# This is the *stack's* env file, distinct from apps/api/.env.example (which
# documents the API's config contract for running it directly with
# `pnpm --filter @ostomy/api start:dev`, outside Docker). Values that the
# API container needs but that are always the same in this stack — the two
# OIDC audiences, the object-storage endpoint, etc. — are set directly in
# infra/docker-compose.yml instead of duplicated here; only the values an
# operator actually chooses live in this file.

# --- Host / LAN ---------------------------------------------------------------
# The LAN hostname or IP address other machines — developer laptops, test
# phones — use to reach THIS server. NOT "localhost", NOT "127.0.0.1" on a
# real deployment.
#
# Why this matters: the mock OIDC provider (navikt/mock-oauth2-server)
# embeds whatever Host header a client used to request a token into that
# token's `iss` claim — it does not have one fixed issuer URL the way
# Cognito does. apps/api checks `iss` by exact string equality (jose's
# jwtVerify, no URL normalisation). If DEV_HOST_ADDRESS does not match the
# address a client actually used to reach mock-oidc on port 8090, every
# token that client mints fails with AUTH_INVALID_ISSUER — a valid
# signature, rejected anyway.
#
# There is deliberately no default that "just works" here (compare
# POSTGRES_PASSWORD below, which is also required but where any value
# works). "localhost" LOOKS like a safe default for same-machine use, but
# `docker compose --env-file .env ... up -d` followed by a health check
# that also runs from localhost (exactly what deploy-dev.yml's `curl
# http://localhost:3000/api/v1/health` does) goes green while every OTHER
# client on the LAN silently fails auth — the specific failure mode this
# variable exists to prevent. deploy-dev.yml's "Verify .env" step fails the
# deploy outright if this is unset, "localhost", or "127.0.0.1"; the
# placeholder below is deliberately neither empty nor one of those, so an
# un-edited copy fails loudly (DNS resolution error) rather than passing.
# Set it to the host's actual LAN hostname or static IP.
DEV_HOST_ADDRESS=REPLACE_WITH_DEV_HOST_LAN_ADDRESS

# --- Bind address ---------------------------------------------------------
# Every published container port below binds to this address, not to
# 0.0.0.0. Docker's own port publishing is a DNAT rule in `nat/PREROUTING`
# plus a filter rule in `FORWARD` — a host `ufw`/`iptables` rule on `INPUT`
# (the traditional "LAN only" firewall rule) does NOT see traffic destined
# for a published container port, because that traffic never reaches
# `INPUT`. Binding explicitly is what actually keeps a published port off
# addresses ufw does not cover.
#
# Default is 127.0.0.1 (loopback only) — safe for a local, single-machine
# checkout. On the shared dev host, set this to the host's LAN address (the
# same value as DEV_HOST_ADDRESS above, typically) so other machines on the
# LAN can reach it; enforcement beyond that is the bind address here plus
# DOCKER-USER iptables rules on the host, not ufw alone — see
# docs/deployment-development.md "Network and access".
DEV_BIND_ADDRESS=127.0.0.1

# --- Postgres -------------------------------------------------------------
# The migration/owner role. Superuser (the Postgres image's own bootstrap
# behavior) — `migrate` connects as this role because it needs to create
# and alter tables. `api` never connects as this role; see
# POSTGRES_RUNTIME_USER below and infra/db/README.md.
POSTGRES_USER=ostomy
POSTGRES_PASSWORD=replace-with-a-local-only-postgres-password
POSTGRES_DB=ostomy_dev

# The runtime role `api` connects as — deliberately unprivileged
# (NOSUPERUSER, NOCREATEDB, NOINHERIT; see infra/db/bootstrap-roles.sql,
# applied by the `db-roles` service in infra/docker-compose.yml). Separate
# from POSTGRES_USER/POSTGRES_PASSWORD above on purpose: a single shared
# superuser is what made the audit-immutability grant model unenforceable
# before this pass — a superuser bypasses every privilege check, so
# limiting `audit_events` to a `GRANT SELECT, INSERT` (P1.S5, ADR-0011;
# never UPDATE/DELETE) for this role would have meant nothing had the API
# still connected as the same superuser that owns the table.
POSTGRES_RUNTIME_USER=ostomy_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-local-only-postgres-password

# --- MinIO (S3 API stand-in; see CLAUDE.md "Never assume AWS-hosted S3") ------
# Doubles as the S3-compatible access key/secret pair the API container uses
# (infra/docker-compose.yml wires these into OBJECT_STORAGE_ACCESS_KEY_ID /
# OBJECT_STORAGE_SECRET_ACCESS_KEY directly — not duplicated here). That
# also means the MinIO console login (LAN-exposed on 9001) and the API's
# storage credential are, today, the same secret — see the comment on the
# `minio` service in infra/docker-compose.yml.
MINIO_ROOT_USER=replace-with-a-local-only-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-local-only-minio-root-password

# --- Optional overrides ---------------------------------------------------
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Clock-skew tolerance (seconds) for JWT exp/iat/nbf checks. See
# apps/api/.env.example for why this exists.
OIDC_CLOCK_TOLERANCE_SECONDS=30
